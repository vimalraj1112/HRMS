# ─────────────────────────────────────────────────────────────
# SuperLink HRMS — server environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME="SuperLink HRMS"
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the API (used in generated links / logs)
API_PUBLIC_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/superlink_hrms?schema=public"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-long-random-string-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12
# Failed logins before an account is temporarily locked
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Redis (optional — the app falls back to in-memory cache when unset/unreachable)
REDIS_URL=
CACHE_TTL_SECONDS=300

# Object storage — driver: "local" | "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads
# Only used when STORAGE_DRIVER=s3 (any S3-compatible provider)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# File upload limits
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info
# Pretty console logs in development
LOG_PRETTY=true
# Include the error stack in API responses (never enable in production)
DEBUG_ERROR_STACK=false

# Email / SMTP (optional — notifications fall back to in-app records)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SuperLink HRMS <no-reply@superlinkitservices.com>"

# Seed credentials (development only — never used in production)
SEED_SUPER_ADMIN_EMAIL=superadmin@superlink.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@123
SEED_HR_ADMIN_EMAIL=hradmin@superlink.local
SEED_HR_ADMIN_PASSWORD=ChangeMe@123
SEED_DEFAULT_PASSWORD=ChangeMe@123
